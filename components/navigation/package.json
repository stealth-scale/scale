{
  "name": "@stealthscale/component-navigation",
  "version": "0.1.0",
  "description": "Draws the ways a person moves between places: links, tabs, breadcrumbs and rails.",
  "keywords": [
    "components",
    "navigation",
    "react",
    "tabs"
  ],
  "homepage": "https://github.com/stealth-scale/scale/tree/main/components/navigation#readme",
  "bugs": "https://github.com/stealth-scale/scale/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stealth-scale/scale.git",
    "directory": "components/navigation"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": {
      "stealth-source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./theme": {
      "stealth-source": "./src/theme.ts",
      "default": "./dist/theme.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./theme": "./dist/theme.js",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "prepublishOnly": "vp pack",
    "test": "vp test"
  },
  "dependencies": {
    "@zag-js/collapsible": "catalog:",
    "@zag-js/navigation-menu": "catalog:",
    "@zag-js/pagination": "catalog:",
    "@zag-js/react": "catalog:",
    "@zag-js/toc": "catalog:",
    "@zag-js/types": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@stealthscale/component-actions": "workspace:^",
    "@stealthscale/component-disclosure": "workspace:^",
    "@stealthscale/component-layout": "workspace:^",
    "@stealthscale/component-primitives": "workspace:^",
    "@stealthscale/hooks": "workspace:^",
    "@stealthscale/theme": "workspace:^",
    "@stealthscale/vite-config": "workspace:^",
    "@stealthscale/vite-config-i18n": "workspace:^",
    "@stealthscale/vite-config-react": "workspace:^",
    "@stealthscale/vite-config-specimen": "workspace:^",
    "@stealthscale/vite-config-theme": "workspace:^",
    "@stealthscale/vite-config-typescript": "workspace:^",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "happy-dom": "catalog:",
    "lucide-react": "catalog:",
    "oxc-transform-react": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@stealthscale/component-actions": "workspace:^",
    "@stealthscale/component-disclosure": "workspace:^",
    "@stealthscale/component-primitives": "workspace:^",
    "@stealthscale/hooks": "workspace:^",
    "@stealthscale/theme": "workspace:^",
    "react": "catalog:"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
