{
  "name": "@stealthscale/provider-router",
  "version": "0.2.0",
  "description": "Publishes the routes an application navigates by, and the options every router starts from.",
  "keywords": [
    "react",
    "router",
    "routing"
  ],
  "homepage": "https://github.com/stealth-scale/config/tree/main/foundations/providers/router#readme",
  "bugs": "https://github.com/stealth-scale/config/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stealth-scale/config.git",
    "directory": "foundations/providers/router"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": {
      "stealth-source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "prepublishOnly": "vp pack",
    "test": "vp test"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@rolldown/plugin-babel": "catalog:",
    "@stealthscale/testing-config": "workspace:^",
    "@stealthscale/vite-config": "workspace:^",
    "@stealthscale/vite-config-react": "workspace:^",
    "@stealthscale/vite-config-typescript": "workspace:^",
    "@tanstack/react-router": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "happy-dom": "catalog:",
    "oxc-transform-react": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-router": "catalog:",
    "react": "catalog:"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
