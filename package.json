{
  "name": "@stealthscale/scale",
  "version": "0.0.0",
  "private": true,
  "description": "Builds, checks, tests and releases every stealthscale package.",
  "type": "module",
  "scripts": {
    "bootstrap": "pnpm -r --filter '{foundations/*}' --filter '{packages/*}' --filter '{components/*}' --filter '{themes/*}' run build",
    "dom": "node scripts/catalogue/dom.ts",
    "prepare": "lefthook install",
    "ready": "pnpm run bootstrap && vp run ci",
    "shot": "node scripts/catalogue/shot.ts"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@stealthscale/component-typography": "workspace:^",
    "@stealthscale/example-lib-actions": "workspace:^",
    "@stealthscale/example-lib-surfaces": "workspace:^",
    "@stealthscale/specimen": "workspace:^",
    "@stealthscale/testing": "workspace:^",
    "@stealthscale/testing-config": "workspace:^",
    "@stealthscale/testing-react": "workspace:^",
    "@stealthscale/testing-router": "workspace:^",
    "@stealthscale/testing-theme": "workspace:^",
    "@stealthscale/vite-config": "workspace:^",
    "@stealthscale/vite-config-css": "workspace:^",
    "@stealthscale/vite-config-react": "workspace:^",
    "@stealthscale/vite-config-specimen": "workspace:^",
    "@stealthscale/vite-config-typescript": "workspace:^",
    "@types/node": "catalog:",
    "@vitest/eslint-plugin": "catalog:",
    "axe-core": "catalog:",
    "eslint-plugin-jsdoc": "catalog:",
    "eslint-plugin-perfectionist": "catalog:",
    "eslint-plugin-tsdoc": "catalog:",
    "lefthook": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^26",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm"
}
