{
  "name": "@stealthscale/pandacss-compiler",
  "version": "0.2.1",
  "description": "Renames a compiled Panda CSS stylesheet and its generated runtime into the readable scheme.",
  "keywords": [
    "class-names",
    "css",
    "design-system",
    "pandacss",
    "postcss"
  ],
  "homepage": "https://github.com/stealth-scale/config/tree/main/packages/pandacss-compiler#readme",
  "bugs": "https://github.com/stealth-scale/config/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stealth-scale/config.git",
    "directory": "packages/pandacss-compiler"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": {
      "stealth-source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "test": "vp test"
  },
  "dependencies": {
    "@pandacss/compiler": "catalog:",
    "@stealthscale/pandacss-naming": "workspace:^",
    "postcss": "catalog:",
    "postcss-selector-parser": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@pandacss/preset-base": "catalog:",
    "@stealthscale/vite-config": "workspace:^",
    "@stealthscale/vite-config-typescript": "workspace:^",
    "@types/node": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
