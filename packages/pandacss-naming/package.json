{
  "name": "@stealthscale/pandacss-naming",
  "version": "0.2.1",
  "description": "Writes the class names of a Panda CSS design system in one readable scheme, for the stylesheet and for the browser alike.",
  "keywords": [
    "class-names",
    "css",
    "design-system",
    "pandacss"
  ],
  "homepage": "https://github.com/stealth-scale/config/tree/main/packages/pandacss-naming#readme",
