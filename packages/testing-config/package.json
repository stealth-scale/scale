{
  "name": "@stealthscale/testing-config",
  "version": "0.5.0",
  "description": "Lists every part of the house contract a config, plugin or library package breaks.",
  "keywords": [
    "config",
    "conformance",
    "testing",
    "vite",
    "vite-plus"
  ],
  "homepage": "https://github.com/stealth-scale/scale/tree/main/packages/testing-config#readme",
  "bugs": "https://github.com/stealth-scale/scale/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stealth-scale/scale.git",
    "directory": "packages/testing-config"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": {
      "stealth-source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "prepublishOnly": "vp pack",
    "test": "vp test"
  },
  "devDependencies": {
    "@stealthscale/testing": "workspace:^",
    "@stealthscale/vite-config": "workspace:^",
    "@stealthscale/vite-config-typescript": "workspace:^",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
