{
  "name": "@stealthscale/testing-plugin",
  "version": "0.2.0",
  "description": "Renders a plugin's components under a real host in a specification, with the session, decisions, flags and data a case states.",
  "keywords": [
    "plugins",
    "react",
    "testing"
  ],
  "homepage": "https://github.com/stealth-scale/scale/tree/main/packages/testing-plugin#readme",
  "bugs": "https://github.com/stealth-scale/scale/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stealth-scale/scale.git",
    "directory": "packages/testing-plugin"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": {
      "stealth-source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "prepublishOnly": "vp pack",
    "test": "vp test"
  },
  "dependencies": {
    "@stealthscale/sdk-core": "workspace:^"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@stealthscale/provider-data": "workspace:^",
    "@stealthscale/provider-form": "workspace:^",
    "@stealthscale/provider-router": "workspace:^",
    "@stealthscale/sdk-host": "workspace:^",
    "@stealthscale/sdk-plugin": "workspace:^",
    "@stealthscale/settings": "workspace:^",
    "@stealthscale/testing-config": "workspace:^",
    "@stealthscale/testing-react": "workspace:^",
    "@stealthscale/vite-config": "workspace:^",
    "@stealthscale/vite-config-i18n": "workspace:^",
    "@stealthscale/vite-config-react": "workspace:^",
    "@stealthscale/vite-config-typescript": "workspace:^",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "happy-dom": "catalog:",
    "i18next": "catalog:",
    "oxc-transform-react": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@stealthscale/provider-data": "workspace:^",
    "@stealthscale/provider-form": "workspace:^",
    "@stealthscale/provider-router": "workspace:^",
    "@stealthscale/sdk-host": "workspace:^",
    "@stealthscale/sdk-plugin": "workspace:^",
    "@stealthscale/settings": "workspace:^",
    "@stealthscale/testing-react": "workspace:^",
    "@testing-library/react": "catalog:",
    "react": "catalog:",
    "react-i18next": "catalog:",
    "vitest": "catalog:peer"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
