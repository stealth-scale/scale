{
  "name": "@stealthscale/vite-config-css",
  "version": "0.2.1",
  "description": "Runs Stylelint over the stylesheets a package imports.",
  "keywords": [
    "config",
    "css",
    "stylelint",
    "vite"
  ],
  "homepage": "https://github.com/stealth-scale/config/tree/main/packages/vite-config-css#readme",
  "bugs": "https://github.com/stealth-scale/config/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stealth-scale/config.git",
    "directory": "packages/vite-config-css"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": {
      "stealth-source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "test": "vp test"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@stealthscale/vite-config": "workspace:^",
    "@stealthscale/vite-config-core": "workspace:^",
    "@stealthscale/vite-config-typescript": "workspace:^",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "publint": "catalog:",
    "stylelint": "catalog:",
    "stylelint-config-standard": "catalog:",
    "stylelint-high-performance-animation": "catalog:",
    "stylelint-order": "catalog:",
    "stylelint-use-nesting": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-stylelint": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@stealthscale/vite-config-core": "workspace:^",
    "stylelint": "catalog:",
    "stylelint-config-standard": "catalog:",
    "stylelint-high-performance-animation": "catalog:",
    "stylelint-order": "catalog:",
    "stylelint-use-nesting": "catalog:",
    "vite": "catalog:peer",
    "vite-plugin-stylelint": "catalog:",
    "vitest": "catalog:peer"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
