{
  "name": "@stealthscale/vite-config-plain",
  "version": "0.2.1",
  "description": "Packs and tests the packages the configuration tiers depend on.",
  "keywords": [
    "config",
    "vite",
    "vite-plus"
  ],
  "homepage": "https://github.com/stealth-scale/config/tree/main/packages/vite-config-plain#readme",
  "bugs": "https://github.com/stealth-scale/config/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stealth-scale/config.git",
    "directory": "packages/vite-config-plain"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": {
      "stealth-source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "prepublishOnly": "vp pack",
    "test": "vp test"
  },
  "devDependencies": {
    "@stealthscale/vite-config-typescript": "workspace:^",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "vite": "catalog:peer",
    "vitest": "catalog:peer"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
