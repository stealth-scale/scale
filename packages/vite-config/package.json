{
  "name": "@stealthscale/vite-config",
  "version": "0.7.0",
  "description": "Configures a package from five Vite+ tiers and a named layer for every block.",
  "keywords": [
    "config",
    "monorepo",
    "preset",
    "vite",
    "vite-plus"
  ],
  "homepage": "https://github.com/stealth-scale/config/tree/main/packages/vite-config#readme",
  "bugs": "https://github.com/stealth-scale/config/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stealth-scale/config.git",
    "directory": "packages/vite-config"
  },
  "files": [
    "dist",
    "globals.d.ts",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": {
      "stealth-source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./preset/app": {
      "stealth-source": "./src/preset/app.ts",
      "default": "./dist/preset/app.mjs"
    },
    "./preset/base": {
      "stealth-source": "./src/preset/base.ts",
      "default": "./dist/preset/base.mjs"
    },
    "./preset/node": {
      "stealth-source": "./src/preset/node.ts",
      "default": "./dist/preset/node.mjs"
    },
    "./preset/web": {
      "stealth-source": "./src/preset/web.ts",
      "default": "./dist/preset/web.mjs"
    },
    "./preset/workspace": {
      "stealth-source": "./src/preset/workspace.ts",
      "default": "./dist/preset/workspace.mjs"
    },
    "./package.json": "./package.json",
    "./globals": "./globals.d.ts"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./preset/app": "./dist/preset/app.mjs",
      "./preset/base": "./dist/preset/base.mjs",
      "./preset/node": "./dist/preset/node.mjs",
      "./preset/web": "./dist/preset/web.mjs",
      "./preset/workspace": "./dist/preset/workspace.mjs",
      "./package.json": "./package.json",
      "./globals": "./globals.d.ts"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "prepublishOnly": "vp pack",
    "test": "vp test"
  },
  "dependencies": {
    "@vitest/eslint-plugin": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@module-federation/vite": "catalog:",
    "@stealthscale/vite-config-core": "workspace:^",
    "@stealthscale/vite-config-typescript": "workspace:^",
    "@stealthscale/vite-plugin-sbom": "workspace:^",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint-plugin-jsdoc": "catalog:",
    "eslint-plugin-perfectionist": "catalog:",
    "eslint-plugin-tsdoc": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@module-federation/vite": "catalog:",
    "@stealthscale/vite-config-core": "workspace:^",
    "@stealthscale/vite-plugin-sbom": "workspace:^",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint-plugin-jsdoc": "catalog:",
    "eslint-plugin-perfectionist": "catalog:",
    "eslint-plugin-tsdoc": "catalog:",
    "happy-dom": "catalog:",
    "publint": "catalog:",
    "vite": "catalog:peer",
    "vitest": "catalog:peer"
  },
  "peerDependenciesMeta": {
    "happy-dom": {
      "optional": true
    },
    "@module-federation/vite": {
      "optional": true
    },
    "@vitest/browser-playwright": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
