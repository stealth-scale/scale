{
  "name": "@stealthscale/sdk-host",
  "version": "0.1.0",
  "description": "Hosts a product composed from plugins: the state its plugins read, its routes, the parts of its frame, its palette and its settings pages.",
  "keywords": [
    "plugins",
    "react",
    "sdk"
  ],
  "homepage": "https://github.com/stealth-scale/scale/tree/main/sdk/host#readme",
  "bugs": "https://github.com/stealth-scale/scale/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stealth-scale/scale.git",
    "directory": "sdk/host"
  },
  "files": [
    "dist",
    "locales",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": {
      "stealth-source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./openfeature": {
      "stealth-source": "./src/openfeature.ts",
      "default": "./dist/openfeature.js"
    },
    "./standalone": {
      "stealth-source": "./src/standalone.ts",
      "default": "./dist/standalone.js"
    },
    "./standalone/app": {
      "stealth-source": "./src/standalone/app.tsx",
      "default": "./dist/standalone/app.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./openfeature": "./dist/openfeature.js",
      "./standalone": "./dist/standalone.js",
      "./standalone/app": "./dist/standalone/app.js",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "prepublishOnly": "vp pack",
    "test": "vp test"
  },
  "dependencies": {
    "@stealthscale/sdk-core": "workspace:^"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@openfeature/core": "catalog:",
    "@openfeature/web-sdk": "catalog:",
    "@stealthscale/component-actions": "workspace:^",
    "@stealthscale/component-feedback": "workspace:^",
    "@stealthscale/component-forms": "workspace:^",
    "@stealthscale/component-layout": "workspace:^",
    "@stealthscale/component-modals": "workspace:^",
    "@stealthscale/component-navigation": "workspace:^",
    "@stealthscale/component-screen": "workspace:^",
    "@stealthscale/component-typography": "workspace:^",
    "@stealthscale/hooks": "workspace:^",
    "@stealthscale/provider-color-mode": "workspace:^",
    "@stealthscale/provider-data": "workspace:^",
    "@stealthscale/provider-environment": "workspace:^",
    "@stealthscale/provider-form": "workspace:^",
    "@stealthscale/provider-hotkeys": "workspace:^",
    "@stealthscale/provider-i18n": "workspace:^",
    "@stealthscale/provider-locale": "workspace:^",
    "@stealthscale/provider-router": "workspace:^",
    "@stealthscale/provider-shell": "workspace:^",
    "@stealthscale/provider-viewport": "workspace:^",
    "@stealthscale/sdk-plugin": "workspace:^",
    "@stealthscale/settings": "workspace:^",
    "@stealthscale/testing-config": "workspace:^",
    "@stealthscale/theme": "workspace:^",
    "@stealthscale/vite-config": "workspace:^",
    "@stealthscale/vite-config-i18n": "workspace:^",
    "@stealthscale/vite-config-react": "workspace:^",
    "@stealthscale/vite-config-typescript": "workspace:^",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-hotkeys": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-ssr-query": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "happy-dom": "catalog:",
    "i18next": "catalog:",
    "oxc-transform-react": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@openfeature/web-sdk": "catalog:",
    "@stealthscale/component-actions": "workspace:^",
    "@stealthscale/component-feedback": "workspace:^",
    "@stealthscale/component-forms": "workspace:^",
    "@stealthscale/component-layout": "workspace:^",
    "@stealthscale/component-modals": "workspace:^",
    "@stealthscale/component-navigation": "workspace:^",
    "@stealthscale/component-screen": "workspace:^",
    "@stealthscale/component-typography": "workspace:^",
    "@stealthscale/hooks": "workspace:^",
    "@stealthscale/provider-color-mode": "workspace:^",
    "@stealthscale/provider-data": "workspace:^",
    "@stealthscale/provider-form": "workspace:^",
    "@stealthscale/provider-hotkeys": "workspace:^",
    "@stealthscale/provider-i18n": "workspace:^",
    "@stealthscale/provider-locale": "workspace:^",
    "@stealthscale/provider-router": "workspace:^",
    "@stealthscale/provider-shell": "workspace:^",
    "@stealthscale/sdk-plugin": "workspace:^",
    "@stealthscale/settings": "workspace:^",
    "@tanstack/react-router-ssr-query": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "peerDependenciesMeta": {
    "@openfeature/web-sdk": {
      "optional": true
    },
    "@stealthscale/provider-color-mode": {
      "optional": true
    },
    "@stealthscale/provider-locale": {
      "optional": true
    },
    "@stealthscale/provider-shell": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
